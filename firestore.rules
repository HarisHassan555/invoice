rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App data for this invoice project (username path: accounts/nouman/...)
    // Covers companies, customers, products, invoices, data, meta, and any future subcollections.
    match /accounts/{accountId}/{document=**} {
      allow read, write: if accountId == 'nouman';
    }

    // Optional: per-signed-in-user paths (if anonymous / email auth is used later)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Optional: device-scoped fallback paths
    match /devices/{deviceId}/{document=**} {
      allow read, write: if true;
    }
  }
}
